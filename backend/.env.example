# ---- Server ----
PORT=3000
HOST=0.0.0.0

# ---- Google Places (nearby stores) ----
# Get a key: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Leave blank to use mock store data.
GOOGLE_PLACES_API_KEY=

# ---- AI provider (yard analysis + redesign) ----
# Options:
#   mock   -> offline sample data (default, no key needed)
#   gemini -> real Google Gemini (vision analysis + image redesign)
# For gemini, get a key at https://aistudio.google.com/ ("Get API key").
AI_PROVIDER=mock
AI_API_KEY=
